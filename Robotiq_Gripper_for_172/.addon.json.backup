        "name": "statusEnable",
        "func": "// payload 已经是数值\nlet value = msg.payload.data;\n\n// 拆开高低字节\nlet highByte = (value >> 8) & 0xFF;  // 高字节\nlet lowByte = value & 0xFF;          // 低字节\n\n\n//检查0x07D0低字节bit0\n//使能成功=1，使能失败=0\n\n\n// 取 bit0，结果只有 0 或 1\nlet gACT = lowByte & 0x01;\n\nmsg.payload = gACT\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": "",
