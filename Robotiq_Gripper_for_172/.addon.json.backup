    {
        "id": "426f5a5f9d550771",
        "type": "function",
        "z": "9c4d31e05e5a8a20",
        "g": "060b625d7f18bc89",
        "name": "Pos & Spare",
        "func": "// payload 已经是数值\nlet value = msg.payload.data;\n\n// 拆开高低字节\nlet highByte = (value >> 8) & 0xFF;  // 高字节\nlet lowByte = value & 0xFF;          // 低字节\n\n// 交换顺序后重新组合（小端转大端）\nlet result = (lowByte << 8) | highByte;\n\nnode.log(value)\nnode.log(highByte)\nnode.log(lowByte)\n\nmsg.position = result;\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 930,
        "y": 1260,
        "wires": [
            [
                "3c6a4f38ea100f10"
            ]
        ]
    },
    {
        "id": "4e36072764d3dc76",
        "type": "function",
        "z": "9c4d31e05e5a8a20",
        "g": "060b625d7f18bc89",
        "name": "Speed & Force",
        "func": "// payload 已经是数值\nlet value = msg.payload.data;\n\n// 拆开高低字节\nlet highByte = (value >> 8) & 0xFF;  // 高字节\nlet lowByte = value & 0xFF;          // 低字节\n\n// 交换顺序后重新组合（小端转大端）\nlet result = (lowByte << 8) | highByte;\n\nnode.log(value)\nnode.log(highByte)\nnode.log(lowByte)\n\nmsg.speed = highByte;\nmsg.force = lowByte;\n\nmsg.payload = {\n    error:msg.error,\n    position: msg.position,\n    force: msg.force,\n    speed: msg.speed,\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
        "y": 1320,
        "wires": [
            [
                "107db2b15f00a834"
            ]
        ]
    },
