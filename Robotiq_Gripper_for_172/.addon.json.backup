    {
        "id": "e29e254d00e64549",
        "type": "function",
        "z": "e740b9b18854b23e",
        "name": "解析密码文件并check输入的密码是否正确",
        "func": "var iniContent = msg.payload;\nvar userInfo_section = global.get(\"userInfo_section\")\nvar userInfo_key = global.get(\"userInfo_key\")\n// 将INI文件内容按行分割\nvar lines = iniContent.split('\\n');\n\n// 解析INI文件内容为对象\nvar config = {};\nvar currentSection = '';\nfor (var i = 0; i < lines.length; i++) {\n    var line = lines[i].trim();\n    if (line.startsWith('[') && line.endsWith(']')) {\n        currentSection = line.substring(1, line.length - 1);\n        config[currentSection] = {};\n    } else if (line.includes('=')) {\n        var parts = line.split('=');\n        var key = parts[0].trim();\n        var value = parts[1].trim();\n        config[currentSection][key] = value;\n    }\n}\nconsole.log(config[userInfo_section][userInfo_key]);\n//返回 value\ntry{\n    if (config[userInfo_section][userInfo_key] == global.get(\"passwd_input\"))\n        msg.payload = 'true';\n    else\n        msg.payload = 'false';\n}catch{\n    msg.payload = 'false'\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1040,
        "y": 1220,
        "wires": [
            [
                "deeaa473110e4087",
                "713a8a4fb0e2eb98"
            ]
        ]
    },
