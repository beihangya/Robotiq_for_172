    {
        "id": "69777fd71cfbfa44",
        "type": "function",
        "z": "dc68ae7bd9f8200b",
        "g": "2335fa6d902f3cbb",
        "name": "0x03E8~0x03EA",
        "func": "msg.cmd_force = Number(global.get(\"force\"))\nmsg.cmd_speed = Number(global.get(\"speed\"))\nmsg.position = Number(global.get(\"pos\"))\n\nlet cmd_position = msg.position;\nlet cmd_speed = msg.cmd_speed; \nlet cmd_force = msg.cmd_force;\n\nif (cmd_position < 0) {\n    cmd_position = 0\n} else if (cmd_position > 255) {\n    cmd_position = 255\n}\n\nif (cmd_force < 20) {\n    cmd_force = 20\n} else if (cmd_force > 255) {\n    cmd_force = 255\n}\n\nif (cmd_speed < 20) {\n    cmd_speed = 20\n} else if (cmd_speed > 255) {\n    cmd_speed = 255\n}\n\nlet hexSpareByte = \"00\"\n\nlet hexcmd_position = cmd_position.toString(16)\n\nlet hexcmd_speed = cmd_speed.toString(16)\n\nlet hexcmd_force = cmd_force.toString(16)\n\nmsg.payload.cmdData = `09 10 03 E8 00 03 06 00 09 ${hexcmd_position} ${hexSpareByte} ${hexcmd_speed} ${hexcmd_force}`\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1090,
        "y": 600,
        "wires": [
