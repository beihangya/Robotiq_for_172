    {
        "id": "e6dd1653140dce0c",
        "type": "function",
        "z": "e740b9b18854b23e",
        "name": "设置modbud类型全局变量",
        "func": "global.set('modbus_type', msg.payload.modbus_type) \n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "// 部署节点后，此处添加的代码将运行一次。 \n// 1. 从全局上下文获取 fs 模块\nconst fs = global.get('fs');\n\n//3. 异步读取（推荐，非阻塞，性能更好）\nfs.readFile('./modbus_config.json', 'utf8', (err, data) => {\n    if (err) {\n        node.error('读取文件失败: ' + err.message);\n        return;\n    }\n    let modbus_in_json = data;\n    node.warn(modbus_in_json)\n    global.set(\"modbus_type\", modbus_in_json);\n\n});\n\n\n\n",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 640,
        "wires": [
