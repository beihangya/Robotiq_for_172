        "id": "3613f460e2195e54",
        "type": "function",
        "z": "e740b9b18854b23e",
        "name": "缓存输入的参数值",
        "func": "global.set(\"userInfo_section\", msg.payload.section)\nglobal.set(\"userInfo_key\", msg.payload.key)\nglobal.set(\"passwd_input\", msg.payload.passwd_in)\nreturn msg;",
