    {
        "id": "bf7255bf687f8c93",
        "type": "function",
        "z": "9c4d31e05e5a8a20",
        "g": "3a21f4ba11fd5c7a",
        "name": "0x03E8~0x03EA",
        "func": "msg.cmd_force = Number(msg.payload.force)\nmsg.cmd_speed = Number(msg.payload.speed)\nmsg.position = Number(msg.payload.position)\n\nlet cmd_position = msg.position;\nlet cmd_speed = msg.cmd_speed; \nlet cmd_force = msg.cmd_force;\n\nif (cmd_position < 0) {\n    cmd_position = 0\n} else if (cmd_position > 255) {\n    cmd_position = 255\n}\n\nif (cmd_force < 20) {\n    cmd_force = 20\n} else if (cmd_force > 255) {\n    cmd_force = 255\n}\n\nif (cmd_speed < 20) {\n    cmd_speed = 20\n} else if (cmd_speed > 255) {\n    cmd_speed = 255\n}\n\nlet hexSpareByte = \"00\"\n\nlet hexcmd_position = cmd_position.toString(16)\n\nlet hexcmd_speed = cmd_speed.toString(16)\n\nlet hexcmd_force = cmd_force.toString(16)\n\nmsg.payload.cmdData = `09 10 03 E8 00 03 06 00 09 ${hexcmd_position} ${hexSpareByte} ${hexcmd_speed} ${hexcmd_force}`\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 520,
        "wires": [
            [
                "2ba03a178d1b0c95"
            ]
        ]
    },
