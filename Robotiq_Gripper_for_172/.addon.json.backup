    {
        "id": "0242f04c362214cc",
        "type": "function",
        "z": "dc68ae7bd9f8200b",
        "g": "40ff848468bd5660",
        "name": "Status & Spare",
        "func": "// payload 已经是数值\nlet value = msg.payload.data;\n\n// 拆开高低字节\nlet highByte = (value >> 8) & 0xFF;  // 高字节\nlet lowByte = value & 0xFF;          // 低字节\n\n\n// 取 bit3 gGTO, 运动中=1，停止=0\nlet bit3 = (lowByte >> 3) & 0x01;\n\nnode.warn(lowByte);\nnode.warn(bit3);\n\nmsg.payload = bit3\n\nif (bit3 == 0) {\n    msg.payload = 1;\n    return [null, msg]; //已停止，输出\n}\nelse {\n    msg.payload = \"\"//运动中，不输出        \n    return [msg, null];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
