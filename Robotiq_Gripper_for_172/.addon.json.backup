    {
        "id": "db4fef5205f3931f",
        "type": "function",
        "z": "dc68ae7bd9f8200b",
        "name": "statusClamping",
        "func": "// payload 已经是数值\nlet value = msg.payload.data;\n\n// 拆开高低字节\nlet highByte = (value >> 8) & 0xFF;  // 高字节\nlet lowByte = value & 0xFF;          // 低字节\n\n//检查0x07D0低字节bit6&7\n//四种0/1/2/3\n\n// 取 bit6 / bit7，合成 gOBJ = 0~3\nlet bit6 = (lowByte >> 6) & 0x01;\nlet bit7 = (lowByte >> 7) & 0x01;\nlet gOBJ = (bit7 << 1) | bit6;\n\n// 0: 正在移动，未检测到物体\n// 1: 张开到位并接触到物体，内撑成功\n// 2: 闭合到位并接触到物体，外夹成功\n// 3: 到位但未检测到物体，或物体丢失\nmsg.payload = gOBJ;  \n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1440,
        "y": 1080,
        "wires": [
