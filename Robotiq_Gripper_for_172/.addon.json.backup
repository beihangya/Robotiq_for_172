    {
        "id": "57dd85fd7ce4ddb7",
        "type": "function",
        "z": "e740b9b18854b23e",
        "name": "save_cmd_type",
        "func": "let write_modbus_type = msg.payload.modbus_type\n\n// 1. 从全局上下文获取 fs 模块\nconst fs = global.get('fs');\n\nfs.writeFile('./modbus_config.json', write_modbus_type, 'utf8', (err) => {\n    if (err) {\n        node.error('写入失败: ' + err.message);\n        // 注意：这里不能 return，因为是在回调函数中\n        // 如果需要通知下游，可以在这里发送错误消息\n    } else {\n        node.send({\n            payload: '文件写入成功',\n            topic: 'write_result'\n        });\n    }\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 700,
        "wires": [
            []
        ]
    },
