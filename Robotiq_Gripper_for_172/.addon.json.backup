        "g": "a9862f0aa6b6990d",
        "name": "statusPosition",
        "func": "let value = msg.payload.data;\n\n// 拆开高低字节\nlet highByte = (value >> 8) & 0xFF;\nlet lowByte = value & 0xFF;\n\n// 交换顺序（小端转大端）\nlet gPR = (lowByte << 8) | highByte;\n\n// 如果你想要的是交换后的高字节（即原来的低字节）\nlet newHighByte = (gPR >> 8) & 0xFF;  // 这个值 = 原来的 lowByte\n\n// 如果你想要的是 highByte 的十进制值\nmsg.payload = highByte;  // 0-255 之间的值\n\nreturn msg;\n",
        "outputs": 1,
