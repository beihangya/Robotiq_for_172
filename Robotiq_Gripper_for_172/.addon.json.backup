    {
        "id": "be6a4f0552287bdf",
        "type": "function",
        "z": "dc68ae7bd9f8200b",
        "g": "40ff848468bd5660",
        "name": "0x03E9 Pos & Spare",
        "func": "msg.cmd_force = Number(global.get(\"force\"))\nmsg.cmd_speed = Number(global.get(\"speed\"))\nmsg.position = Number(global.get(\"pos\"))\n\nlet cmd_pos = msg.position;\nlet pos_reg = cmd_pos << 8;  // 高字节为 cmd_pos，低字节为 0\n\nmsg.payload = {\n    \"setType\": \"IO\",\n    \"ioSource\": \"modbusM\",\n    \"extIoModuleName\": \"pc_3\",     // tab名称\n    \"ioType\": \"ao\",\n    \"ioIndex\": 1,\n    \"aoValue\": pos_reg,\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1260,
        "y": 800,
        "wires": [
            [
                "47d7bfe381426dcd"
            ]
        ]
    },
    {
        "id": "ac248ab423c56754",
        "type": "function",
        "z": "dc68ae7bd9f8200b",
        "g": "40ff848468bd5660",
        "name": "0x03EA Speed & Force",
        "func": "msg.cmd_force = Number(global.get(\"force\"))\nmsg.cmd_speed = Number(global.get(\"speed\"))\nmsg.position = Number(global.get(\"pos\"))\n\nlet cmd_spd = msg.cmd_speed;    // 0x64\nlet cmd_force = msg.cmd_force;  // 0xFF\nlet para_reg = (cmd_spd << 8) | cmd_force;  // 高字节=spd，低字节=force\n\nmsg.payload = {\n    \"setType\": \"IO\",\n    \"ioSource\": \"modbusM\",\n    \"extIoModuleName\": \"pc_3\",     // tab名称\n    \"ioType\": \"ao\",\n    \"ioIndex\": 2,\n    \"aoValue\": para_reg,\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1270,
        "y": 840,
