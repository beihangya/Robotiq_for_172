    {
        "id": "21197056d23bd1a9",
        "type": "function",
        "z": "dc68ae7bd9f8200b",
        "g": "ba56e0afdc5c5eb3",
        "name": "Status & Spare",
        "func": "const initMode = global.get(\"initMode\")\n\n// payload 已经是数值\nlet value = msg.payload.data;\n\nnode.warn(msg.payload)\n\n// 拆开高低字节\nlet highByte = (value >> 8) & 0xFF;  // 高字节\nlet lowByte = value & 0xFF;          // 低字节\n\n\n//检查0x07D0低字节bit0\n//使能 - 使能成功=1，使能失败=0，当bit0=1时，输出1\n//下使能 - 下使能成功 =0，下使能失败=1，当bit0=0时，输出1\n\n\n// 取 bit0，结果只有 0 或 1\nlet bit0 = lowByte & 0x01;\n\n\n\n// 现有流程：initMode=0 为使能，initMode=1 为使能为下使能\n\nif (Number(initMode) == 0) {\n    if (bit0 == 1) {\n        msg.payload = bit0;\n        return [null, msg]; //上使能成功，输出\n    }\n    else {\n        msg.payload = \"\"\n        return [msg, null];//上使能失败，不输出\n    }\n}\n\n\nif (Number(initMode) == 1) {\n    if (bit0 == 0) {\n        msg.payload = 1;\n        return [null, msg]; //下使能成功，输出\n    }\n    else {\n        msg.payload = \"\"//下使能失败，不输出        \n        return [msg, null];\n    }\n}\n\n\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2100,
        "y": 420,
        "wires": [
            [
                "8bfeaf7f9f24e98d"
            ],
            [
                "d7d37937bca10daf"
            ]
        ]
