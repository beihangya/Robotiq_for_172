    {
        "id": "4c4e4686365427f0",
        "type": "function",
        "z": "9c4d31e05e5a8a20",
        "g": "fc5a0ef2e3b6aaaf",
        "name": "0x03E9 Pos & Spare",
        "func": "global.set(\"force\", msg.payload.force)\nglobal.set(\"speed\", msg.payload.speed)\nglobal.set(\"pos\", msg.payload.position)\n\nlet cmd_pos = msg.payload.position;\nlet pos_reg = cmd_pos << 8;  // 高字节为 cmd_pos，低字节为 0\n\nmsg.payload = {\n    \"setType\": \"IO\",\n    \"ioSource\": \"modbusM\",\n    \"ioType\": \"ao\",\n    \"ioIndex\": 1,\n    \"extIoModuleName\": \"jodell_cab\",     // tab名称\n    \"aoValue\": pos_reg,\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 680,
        "wires": [
            [
                "805cec3409df4817"
            ]
        ]
    },
    {
        "id": "68585dda04ab5838",
        "type": "function",
        "z": "9c4d31e05e5a8a20",
        "g": "fc5a0ef2e3b6aaaf",
        "name": "0x03EA Speed & Force",
        "func": "global.set(\"force\", msg.payload.force)\nglobal.set(\"speed\", msg.payload.speed)\nglobal.set(\"pos\", msg.payload.position)\n\nlet cmd_spd = msg.payload.speed;    // 0x64\nlet cmd_force = msg.payload.force;  // 0xFF\nlet para_reg = (cmd_spd << 8) | cmd_force;  // 高字节=spd，低字节=force\n\nmsg.payload = {\n    \"setType\": \"IO\",\n    \"ioSource\": \"modbusM\",\n    \"ioType\": \"ao\",\n    \"ioIndex\": 2,\n    \"extIoModuleName\": \"jodell_cab\",     // tab名称\n    \"aoValue\": para_reg,\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 990,
        "y": 740,
        "wires": [
