    {
        "id": "f6069705bca5f134",
        "type": "function",
        "z": "9c4d31e05e5a8a20",
        "g": "a9c60f7ba775f973",
        "name": "Status & Spare",
        "func": "// payload 已经是数值\nlet value = msg.payload.data;\n\n// 拆开高低字节\nlet highByte = (value >> 8) & 0xFF;  // 高字节\nlet lowByte = value & 0xFF;          // 低字节\n\n// 交换顺序后重新组合（小端转大端）\nlet result = (lowByte << 8) | highByte;\n\nmsg.error = result\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 940,
